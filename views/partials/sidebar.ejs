<!-- Mobile drawer -->
<div id="mobileSidebar" class="hidden fixed inset-0 z-[80] md:hidden">
  <div class="absolute inset-0 bg-black/40" onclick="closeMobileSidebar()"></div>
  <aside class="absolute top-0 bottom-0 right-0 w-[280px] bg-surface-container-low border-l border-outline-variant flex flex-col">
    <div class="flex justify-end p-sm border-b border-outline-variant">
      <button onclick="closeMobileSidebar()" class="p-xs text-on-surface-variant hover:bg-surface-container-high rounded-full transition-colors" aria-label="إغلاق القائمة">
        <span class="material-symbols-outlined">close</span>
      </button>
    </div>
    <div class="flex-1 overflow-y-auto flex flex-col">
      <%- include('sidebar-content', { active: active }) %>
    </div>
  </aside>
</div>

<!-- Desktop sidebar -->
<nav class="hidden md:flex flex-col h-screen overflow-y-auto bg-surface-container-low border-l border-outline-variant fixed right-0 top-0 w-[280px] z-40">
  <%- include('sidebar-content', { active: active }) %>
</nav>

<script>
  function openMobileSidebar() {
    document.getElementById('mobileSidebar').classList.remove('hidden');
  }
  function closeMobileSidebar() {
    document.getElementById('mobileSidebar').classList.add('hidden');
  }
</script>
