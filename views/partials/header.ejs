<header class="bg-surface border-b border-outline-variant flex flex-row-reverse justify-between items-center px-lg py-sm w-full sticky top-0 z-30">
  <div class="flex items-center gap-md">
    <span class="font-display-lg-mobile text-display-lg-mobile font-bold text-primary md:hidden">نظام إدارة الأقساط</span>
    <span class="hidden md:block font-headline-md text-headline-md font-bold text-primary"><%= typeof pageTitle !== 'undefined' ? pageTitle : '' %></span>
  </div>
  <div class="flex items-center gap-md flex-row-reverse">
    <% if (typeof showSearch === 'undefined' || showSearch) { %>
    <div class="hidden md:flex relative mr-lg">
      <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant">search</span>
      <input class="bg-surface-container-low border border-outline-variant rounded-full py-xs pr-xl pl-md font-body-md text-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary w-64 transition-all" placeholder="<%= typeof searchPlaceholder !== 'undefined' ? searchPlaceholder : 'بحث...' %>" type="text" <%= typeof searchHref !== 'undefined' ? '' : '' %>/>
    </div>
    <% } %>
    <a href="/rent/notifications" class="p-xs text-secondary hover:bg-surface-container-high rounded-full transition-colors relative">
      <span class="material-symbols-outlined">notifications</span>
      <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
      <span class="absolute top-1 right-1 w-2 h-2 bg-error rounded-full"></span>
      <% } %>
    </a>
    <a href="/rent/settings" class="p-xs text-secondary hover:bg-surface-container-high rounded-full transition-colors">
      <span class="material-symbols-outlined">settings</span>
    </a>
    <div class="w-8 h-8 rounded-full bg-secondary-container overflow-hidden border border-outline-variant ml-sm flex items-center justify-center text-on-secondary font-bold">
      <span class="material-symbols-outlined text-[18px]">person</span>
    </div>
    <button onclick="openMobileSidebar()" class="md:hidden p-xs text-secondary hover:bg-surface-container-high rounded-full transition-colors" aria-label="القائمة">
      <span class="material-symbols-outlined">menu</span>
    </button>
  </div>
</header>
