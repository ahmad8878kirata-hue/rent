<%- include('partials/head', { title: 'الإشعارات' }) %>
<body class="bg-background text-on-background flex min-h-screen selection:bg-primary-fixed selection:text-on-primary-fixed">
<%- include('partials/sidebar', { active: active }) %>
<main class="flex-1 md:mr-[280px] w-full min-h-screen flex flex-col">
  <%- include('partials/header', { pageTitle: 'مركز الإشعارات', unreadCount: unreadCount }) %>
  <div class="flex-1 p-margin max-w-[1240px] mx-auto w-full">
    <div class="mb-lg flex flex-wrap justify-between items-end gap-sm">
      <div>
        <h2 class="font-display-lg text-display-lg text-on-surface mb-xs">مركز الإشعارات</h2>
        <p class="font-body-md text-body-md text-on-surface-variant">متابعة التنبيهات والأقساط المستحقة <% if (unreadCount > 0) { %>(<span class="text-error font-bold"><%= unreadCount %></span> غير مقروء)<% } %></p>
      </div>
      <div class="flex gap-sm">
        <form method="get" action="/rent/notifications" class="relative">
          <select name="filter" class="appearance-none bg-surface-container border border-outline-variant rounded-lg font-label-sm text-label-sm text-on-surface hover:bg-surface-container-high transition-colors py-sm pl-xl pr-md cursor-pointer" onchange="this.form.submit()">
            <option value="all" <%= filter === 'all' ? 'selected' : '' %>>الكل</option>
            <option value="unread" <%= filter === 'unread' ? 'selected' : '' %>>غير مقروء</option>
            <option value="overdue" <%= filter === 'overdue' ? 'selected' : '' %>>المتأخرات</option>
          </select>
          <span class="material-symbols-outlined absolute left-sm top-1/2 -translate-y-1/2 pointer-events-none text-on-surface-variant">arrow_drop_down</span>
        </form>
        <button onclick="markAllRead()" class="px-md py-sm bg-surface-container border border-outline-variant rounded-lg font-label-sm text-label-sm text-on-surface hover:bg-surface-container-high transition-colors">تحديد الكل كمقروء</button>
      </div>
    </div>

    <div class="flex flex-col gap-sm">
      <% if (notifications.length === 0) { %>
      <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-lg text-center text-secondary font-body-md text-body-md">
        <span class="material-symbols-outlined text-4xl block mb-sm">notifications_off</span>
        لا توجد إشعارات
      </div>
      <% } %>
      <% notifications.forEach(function(n) { %>
      <div class="<%= n.type === 'overdue' ? 'bg-error-container border border-error/20 hover:bg-error-container/80' : (n.type === 'upcoming' ? 'bg-surface-container-lowest border border-outline-variant hover:bg-surface-container-low' : 'bg-surface-container border border-outline-variant hover:bg-surface-container-high') %> rounded-xl p-md flex items-start gap-md transition-colors relative group">
        <div class="absolute right-0 top-0 bottom-0 w-1 <%= n.type === 'overdue' ? 'bg-error' : (n.type === 'upcoming' ? 'bg-primary' : 'bg-secondary opacity-50') %> rounded-r-xl"></div>
        <div class="p-sm <%- n.type === 'overdue' ? 'bg-error/10 text-error' : (n.type === 'upcoming' ? 'bg-primary/10 text-primary' : 'bg-tertiary/10 text-tertiary') %> rounded-full flex-shrink-0 mt-xs">
          <span class="material-symbols-outlined"><%= n.type === 'overdue' ? 'warning' : (n.type === 'upcoming' ? 'calendar_today' : 'info') %></span>
        </div>
        <div class="flex-1">
          <div class="flex justify-between items-start mb-xs">
            <h3 class="font-title-sm text-title-sm text-on-surface <%= n.is_read ? 'opacity-70' : '' %>"><%= n.title %></h3>
            <span class="font-caption-xs text-caption-xs <%= n.type === 'overdue' ? 'text-error' : (n.type === 'upcoming' ? 'text-primary' : 'text-on-surface-variant') %> font-bold flex items-center gap-xs">
              <% if (!n.is_read) { %><span class="w-2 h-2 rounded-full <%= n.type === 'overdue' ? 'bg-error' : 'bg-primary' %>"></span><% } %>
              <%= helpers.fmtDate(n.created_at) %>
            </span>
          </div>
          <p class="font-body-md text-body-md text-on-surface-variant mb-md"><%= n.message %></p>
          <div class="flex gap-sm">
            <% if (n.related_customer_id) { %>
            <a href="/rent/customers/<%= n.related_customer_id %>" data-action="notif-read" data-id="<%= n.id %>" class="px-md py-xs <%- n.type === 'overdue' ? 'bg-error text-on-error' : 'bg-primary text-on-primary' %> rounded-lg font-label-sm text-label-sm hover:opacity-90 transition-opacity">عرض التفاصيل</a>
            <button data-action="notif-remind" data-notif-id="<%= n.id %>" data-customer-id="<%= n.related_customer_id %>" class="px-md py-xs bg-transparent border border-outline-variant text-on-surface rounded-lg font-label-sm text-label-sm hover:bg-surface-container transition-colors">إرسال تذكير</button>
            <% } else { %>
            <a href="/rent/settings" class="px-md py-xs bg-surface-container-high text-on-surface rounded-lg font-label-sm text-label-sm hover:bg-surface-variant transition-colors border border-outline-variant">مراجعة الإعدادات</a>
            <% } %>
            <button data-action="notif-read" data-id="<%= n.id %>" class="px-md py-xs text-on-surface-variant hover:text-on-surface font-caption-xs text-caption-xs underline">تحديد كمقروء</button>
          </div>
        </div>
      </div>
      <% }); %>
    </div>
  </div>
</main>
<%- include('partials/scripts') %>
<script>
  function markRead(id) {
    fetch('/api/notifications/' + id + '/read', { method: 'POST' });
  }
  function markAllRead() {
    fetch('/api/notifications/read-all', { method: 'POST' })
      .then(function (r) { return r.json(); })
      .then(function (j) { if (j.ok) window.location.reload(); });
  }
  function sendReminder(notifId, customerId) {
    fetch('/api/customers/' + customerId + '/reminder', { method: 'POST' })
      .then(function (r) { return r.json(); })
      .then(function (j) {
        if (j.ok) { showToast('تم إرسال رسالة التذكير'); markRead(notifId); }
        else { showToast(j.error || 'حدث خطأ', 'error'); }
      });
  }
  document.addEventListener('click', function (e) {
    var btn = e.target.closest('[data-action]');
    if (!btn) return;
    var action = btn.getAttribute('data-action');
    if (action === 'notif-read') markRead(parseInt(btn.getAttribute('data-id'), 10));
    else if (action === 'notif-remind') sendReminder(parseInt(btn.getAttribute('data-notif-id'), 10), parseInt(btn.getAttribute('data-customer-id'), 10));
  });
</script>
</body>
</html>
